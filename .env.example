# AETHER ENGINEER Configuration

# Application
APP_ENV=development
DEBUG=true
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite:///./aether_engineer.db

# Workspace & Security
WORKSPACE_ROOT=./workspaces
ALLOWED_REPO_ROOTS=["/Users/shanjaisenthil/Documents", "/Users/shanjaisenthil/Projects"]
ISOLATED_SANDBOX_TIMEOUT_SECONDS=60
MAX_REPAIR_ATTEMPTS=3
MAX_PARALLEL_TASKS=2

# LLM Gateway Settings
# Providers: unconfigured | openai | anthropic | gemini | ollama
LLM_PROVIDER=unconfigured
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434

